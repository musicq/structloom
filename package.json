{
  "name": "structloom",
  "version": "0.0.1",
  "packageManager": "pnpm@11.17.0",
  "description": "Type-safe data structures for TypeScript and JavaScript.",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test:types": "vitest run --typecheck.only --typecheck.tsconfig tsconfig.type-tests.json",
    "test:w": "vitest",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run test:types && pnpm test"
  },
  "keywords": [
    "data-structures",
    "typescript",
    "algorithms"
  ],
  "license": "MIT",
  "author": "Liang Kui",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musicq/structloom.git"
  },
  "bugs": {
    "url": "https://github.com/musicq/structloom/issues"
  },
  "homepage": "https://github.com/musicq/structloom#readme",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  }
}
